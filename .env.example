# Copy this to .env.local and fill in your actual Supabase credentials. Never commit .env.local.
# FinDat Supabase Configuration
# Replace these with your project URL and anon public key from Supabase Dashboard > Project Settings > API
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key-here

# Twelve Data API Configuration (for Market Data & NSE/BSE Equity series)
# Set TWELVE_DATA_API_KEY in your Supabase Project Settings > Secrets for Edge Functions
TWELVE_DATA_API_KEY=your-twelve-data-api-key-here
VITE_TWELVE_DATA_API_KEY=your-twelve-data-api-key-here

